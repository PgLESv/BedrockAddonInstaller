# .gitignore para Minecraft Bedrock Addon Installer

# Arquivos do sistema operacional
.DS_Store
Thumbs.db
desktop.ini

# Arquivos de editor
.vscode/
.idea/
*.swp
*.swo
*~

# Arquivos temporários
*.tmp
*.temp

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Node modules (caso adicione ferramentas de build no futuro)
node_modules/
package-lock.json
yarn.lock

# Arquivos de teste
test/
*.test.js

# Arquivos de addons usados para teste
*.mcpack
*.mcaddon
*.zip
*.rar

# Ambiente
.env
.env.local
